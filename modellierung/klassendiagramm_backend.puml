@startuml
title Lokaler Vorschau-Server CampusKompass

skinparam shadowing false

class SimpleHTTPRequestHandler <<http.server>> {
}

class DashboardHandler {
  -directory: str
  +__init__(*args, **kwargs)
}

class ThreadingHTTPServer <<http.server>> {
  +serve_forever()
  +server_close()
}

class "server.py" as ServerModule <<module>> {
  HOST: str
  PORT: int
  +main()
}

DashboardHandler --|> SimpleHTTPRequestHandler
ServerModule ..> DashboardHandler : erzeugt
ServerModule ..> ThreadingHTTPServer : startet
ThreadingHTTPServer o-- DashboardHandler : verarbeitet Requests

note right of DashboardHandler
  Liefert ausschließlich statische
  Projektdateien für die lokale Vorschau.
  Für die Veröffentlichung kann GitHub
  Pages verwendet werden.
end note
@enduml
