@startuml
title Paketdiagramm CampusKompass

skinparam packageStyle rectangle
skinparam shadowing false

package "CampusKompass" {
  package "Frontend" {
    [index.html\nHTML, CSS, JavaScript] as Frontend
  }

  package "Daten" {
    database "study-plan.json" as StudyPlan
    folder "assets/\nLogos" as Assets
  }
}

package "Externe Dienste" {
  cloud "OpenMensa API" as Mensa
  cloud "Open-Meteo" as Weather
  cloud "Google Maps" as Maps
  cloud "VMT Fahrplanauskunft" as VMT
}

Frontend --> StudyPlan : liest
Frontend --> Assets : zeigt
Frontend --> Mensa : Speiseplan (JSON)
Frontend --> Weather : Wetterdaten
Frontend --> Maps : Routenkarte
Frontend --> VMT : Fahrplan-Widget

@enduml
