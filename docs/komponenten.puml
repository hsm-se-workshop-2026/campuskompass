@startuml
title Vereinfachte Architektur des Projekts

skinparam componentStyle rectangle
skinparam shadowing false

actor "Nutzer/in" as User

package "CampusKompass" {
  component "index.html\nHTML, CSS und JavaScript" as Dashboard
  database "study-plan.json" as StudyPlan
  database "mensa-data.json\n14-Tage-Snapshot" as MenuData
  database "fuel-stations.json\nTankstellen-Snapshot" as FuelData
  folder "campuskompass/assets/\nLogos" as Logos
}

cloud "GitHub Actions\nMensa alle 6 Stunden;\nTankstellen alle 15 Minuten" as Actions
cloud "Studierendenwerk Thüringen" as Mensa
cloud "Tankerkönig API" as FuelApi
cloud "GitHub Pages" as Pages
cloud "Open-Meteo" as Weather
cloud "Google Maps" as Maps

User --> Dashboard : öffnet im Browser
Dashboard --> StudyPlan : liest Termine
Dashboard --> MenuData : liest Speisepläne
Dashboard --> FuelData : liest Tankstellenpreise
Dashboard --> Logos : zeigt Logos
Dashboard --> Weather : lädt Wetterdaten
Dashboard --> Maps : erstellt Wegbeschreibung
Actions --> Mensa : ruft Speisepläne ab
Actions --> MenuData : erzeugt Snapshot
Actions --> FuelApi : ruft Preise mit Secret ab
Actions --> FuelData : erzeugt Snapshot
Actions --> Pages : veröffentlicht statische Seite
Pages --> Dashboard : stellt Seite und Daten bereit

@enduml
